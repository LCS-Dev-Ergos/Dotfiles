{
  // Personal base configuration for the VS Code markdownlint extension, deployed to
  // ~/.config/markdownlint by Home Manager and referenced from the user settings through
  // "markdownlint.configFile". The extension hands it to markdownlint-cli2 as an options file
  // (rules under "config", plus "customRules"), which a plain .markdownlint.jsonc cannot express.
  // A project's own .markdownlint.* or .markdownlint-cli2.* file replaces it for that project.
  //
  // The rules are the reduced, safe-to-autofix set in safe.jsonc. extended.jsonc adds the full
  // style rules for reports on request; run it with `mdlint --extended`.
  "customRules": ["./rules/table-delimiter-dashes.cjs"],
  "config": {
    "extends": "./safe.jsonc",
  },
}
