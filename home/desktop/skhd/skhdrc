# =====----- Skhd Configuration file ------------------------------------===== #
#
# Modifiers are chosen to stay clear of application shortcuts: lalt (right
# Option still types the Italian layout's special characters), ctrl + lalt and
# ctrl + shift + cmd. shift + cmd and shift + ctrl are left to applications
# (text selection, kitty and tmux tabs and scrolling).
#
# Space bindings go through ~/.config/yabai/space.sh, which fades in the
# windows of the space it switches to and focuses one of them.

# ============================================================================ #
# =====----- WINDOW AND SPACE NAVIGATION --------------------------------===== #

# Window navigation (across display borders): lalt - {h, j, k, l}
lalt - h : yabai -m window --focus west  || yabai -m display --focus west
lalt - j : yabai -m window --focus south || yabai -m display --focus south
lalt - k : yabai -m window --focus north || yabai -m display --focus north
lalt - l : yabai -m window --focus east  || yabai -m display --focus east

# Space navigation by mission-control index, as SketchyBar numbers them:
# lalt - {1, 2, ..., 9, 0}, with 0 for space 10
lalt - 1 : ~/.config/yabai/space.sh focus 1
lalt - 2 : ~/.config/yabai/space.sh focus 2
lalt - 3 : ~/.config/yabai/space.sh focus 3
lalt - 4 : ~/.config/yabai/space.sh focus 4
lalt - 5 : ~/.config/yabai/space.sh focus 5
lalt - 6 : ~/.config/yabai/space.sh focus 6
lalt - 7 : ~/.config/yabai/space.sh focus 7
lalt - 8 : ~/.config/yabai/space.sh focus 8
lalt - 9 : ~/.config/yabai/space.sh focus 9
lalt - 0 : ~/.config/yabai/space.sh focus 10

# Previous/next space via the scripting addition (no macOS slide animation),
# wrapping around at the ends. Replaces the native Mission Control shortcuts,
# which are disabled.
ctrl - left  : ~/.config/yabai/space.sh focus prev
ctrl - right : ~/.config/yabai/space.sh focus next

# Cycle through the windows of a stack, wrapping around
lalt - n : yabai -m window --focus stack.next || yabai -m window --focus stack.first
lalt - p : yabai -m window --focus stack.prev || yabai -m window --focus stack.last

# ============================================================================ #
# =====----- MOVE WINDOWS BETWEEN SPACES --------------------------------===== #

# Send the focused window to a space and follow it: shift + lalt - {1, ..., 0}
shift + lalt - 1 : ~/.config/yabai/space.sh move 1
shift + lalt - 2 : ~/.config/yabai/space.sh move 2
shift + lalt - 3 : ~/.config/yabai/space.sh move 3
shift + lalt - 4 : ~/.config/yabai/space.sh move 4
shift + lalt - 5 : ~/.config/yabai/space.sh move 5
shift + lalt - 6 : ~/.config/yabai/space.sh move 6
shift + lalt - 7 : ~/.config/yabai/space.sh move 7
shift + lalt - 8 : ~/.config/yabai/space.sh move 8
shift + lalt - 9 : ~/.config/yabai/space.sh move 9
shift + lalt - 0 : ~/.config/yabai/space.sh move 10

# Send the focused window to the previous/next space and follow it, wrapping
# around: ctrl + lalt - {left, right} or shift + lalt - {p, n}
ctrl + lalt - left  : ~/.config/yabai/space.sh move prev
ctrl + lalt - right : ~/.config/yabai/space.sh move next
shift + lalt - p : ~/.config/yabai/space.sh move prev
shift + lalt - n : ~/.config/yabai/space.sh move next

# ============================================================================ #
# =====----- WINDOW MANIPULATION ----------------------------------------===== #

# Equalize window size
ctrl + lalt - e : yabai -m space --balance

# Change split type
lalt - e : yabai -m window --toggle split

# Close window
ctrl + lalt - c : yabai -m window --close

# Minimize window
lalt - m : yabai -m window --minimize

# Rotate tree
lalt - r : yabai -m space --rotate 90

# Mirror tree on the x, y axes
lalt - x : yabai -m space --mirror x-axis
lalt - y : yabai -m space --mirror y-axis

# Float / unfloat window and center it (the grid only applies when floating)
lalt - t : yabai -m window --toggle float --grid 4:4:1:1:2:2

# Toggle desktop padding
lalt - a : yabai -m space --toggle padding; yabai -m space --toggle gap

# Toggle parent zoom / fullscreen zoom of the focused window
lalt - d : yabai -m window --toggle zoom-parent
lalt - f : yabai -m window --toggle zoom-fullscreen

# Increase, decrease gap in the active space
lalt - g : yabai -m space --gap rel:20
shift + lalt - g : yabai -m space --gap rel:-20

# Toggle window native fullscreen
shift + lalt - f : yabai -m window --toggle native-fullscreen

# ============================================================================ #
# =====----- MOVE WINDOWS WITHIN LAYOUT ---------------------------------===== #

# Warp window in direction: shift + lalt - {h, j, k, l}
shift + lalt - h : yabai -m window --warp west
shift + lalt - j : yabai -m window --warp south
shift + lalt - k : yabai -m window --warp north
shift + lalt - l : yabai -m window --warp east

# ============================================================================ #
# =====----- STACKS AND INSERTION ---------------------------------------===== #

# Stack the focused window onto its neighbour: ctrl + shift + cmd - {h, j, k, l}
ctrl + shift + cmd - h : yabai -m window west --stack $(yabai -m query --windows --window | jq -r '.id')
ctrl + shift + cmd - j : yabai -m window south --stack $(yabai -m query --windows --window | jq -r '.id')
ctrl + shift + cmd - k : yabai -m window north --stack $(yabai -m query --windows --window | jq -r '.id')
ctrl + shift + cmd - l : yabai -m window east --stack $(yabai -m query --windows --window | jq -r '.id')

# Set insertion point for the container: shift + ctrl + lalt - {h, j, k, l, s}
shift + ctrl + lalt - h : yabai -m window --insert west
shift + ctrl + lalt - j : yabai -m window --insert south
shift + ctrl + lalt - k : yabai -m window --insert north
shift + ctrl + lalt - l : yabai -m window --insert east
shift + ctrl + lalt - s : yabai -m window --insert stack

# ============================================================================ #
# =====----- WINDOW RESIZING --------------------------------------------===== #

# Increase window size
ctrl + lalt - h : yabai -m window --resize left:-20:0
ctrl + lalt - j : yabai -m window --resize bottom:0:20
ctrl + lalt - k : yabai -m window --resize top:0:-20
ctrl + lalt - l : yabai -m window --resize right:20:0

# Decrease window size
ctrl + lalt + cmd - h : yabai -m window --resize left:20:0
ctrl + lalt + cmd - j : yabai -m window --resize bottom:0:-20
ctrl + lalt + cmd - k : yabai -m window --resize top:0:20
ctrl + lalt + cmd - l : yabai -m window --resize right:-20:0

# ============================================================================ #
# =====----- LAYOUT AND SERVICES ----------------------------------------===== #

# Toggle sketchybar
shift + lalt - space : sketchybar --bar hidden=toggle

# Stop/Start/Restart yabai. It runs as nix-darwin's org.nixos.yabai agent:
# yabai --start-service would install and start a second, unmanaged one.
ctrl + lalt - q : launchctl bootout "gui/$(id -u)/org.nixos.yabai"
ctrl + lalt - s : launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/org.nixos.yabai.plist"
ctrl + lalt - r : launchctl kickstart -k "gui/$(id -u)/org.nixos.yabai"

# Change desktop layout
ctrl + lalt - a : yabai -m space --layout bsp
ctrl + lalt - d : yabai -m space --layout float

# ============================================================================ #
