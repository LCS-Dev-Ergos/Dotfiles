#!/usr/bin/env sh
# ============================================================================ #
# =====----- Yabai Configuration file -----------------------------------===== #

# =====----- Scripting Addition -----------------------------------------===== #
# nix-darwin's services.yabai writes /etc/sudoers.d/yabai for this exact
# binary, so loading the scripting addition needs no password.

sudo yabai --load-sa
yabai -m signal --add label="load_sa" event=dock_did_restart action="sudo yabai --load-sa"

# Closing, minimizing or hiding the focused window can leave no window focused, so
# keyboard commands would have nothing to act on. Focus the window under the
# mouse, or else the first tiled window of the space. Space switches go
# through ~/.config/yabai/space.sh, which focuses a window itself.
FOCUS_FALLBACK="yabai -m query --windows --window >/dev/null 2>&1 \
    || yabai -m window --focus mouse >/dev/null 2>&1 \
    || yabai -m window --focus first >/dev/null 2>&1 || true"
yabai -m signal --add label="focus_after_destroy" event=window_destroyed active=yes action="$FOCUS_FALLBACK"
yabai -m signal --add label="focus_after_minimize" event=window_minimized active=yes action="$FOCUS_FALLBACK"
yabai -m signal --add label="focus_after_quit" event=application_terminated active=yes action="$FOCUS_FALLBACK"
yabai -m signal --add label="focus_after_hide" event=application_hidden active=yes action="$FOCUS_FALLBACK"

# =====----- Aspect Customization ---------------------------------------===== #

# ease_out_cubic spreads the motion over the whole animation. Steeper curves
# (quint, expo) finish almost at once and then hold yabai's static snapshot of
# the window until the real one replaces it, which reads as a delay.
#
# Focus changes opacity by only 2.5%, too little to see animated. Applying it
# at once spares the Dock a timed fade for every focus change; Desktop
# navigation keeps its own fade.
yabai -m config external_bar all:40:0 \
    mouse_follows_focus off \
    focus_follows_mouse off \
    window_zoom_persist off \
    window_placement second_child \
    window_shadow float \
    window_opacity on \
    active_window_opacity 1.0 \
    normal_window_opacity 0.975 \
    window_opacity_duration 0.0 \
    window_animation_duration 0.2 \
    window_animation_easing ease_out_cubic \
    insert_feedback_color 0xff565f89 \
    auto_balance off \
    split_type auto \
    split_ratio 0.5 \
    mouse_modifier cmd \
    mouse_action1 move \
    mouse_action2 resize \
    mouse_drop_action swap \
    top_padding 8 \
    bottom_padding 12 \
    left_padding 12 \
    right_padding 12 \
    window_gap 12

# bsp, stack or float
yabai -m config layout bsp

# Desktop navigation (space.sh): the effect of every switch. `yabai -m config`
# changes these while yabai runs; they return to these values when it
# restarts. Kept apart from the settings above, which an unknown setting must
# not abort.
#   navigation_effect             on or off, for every switch
#   navigation_effect_type        crossfade (Screen Recording, about 280 ms to
#                                 the first change) or veil (captures nothing,
#                                 about 50 ms)
#   navigation_effect_duration    seconds in [0,1]
#   navigation_pressure_fallback  what a crossfade becomes under memory
#                                 pressure: veil, keep or none
#   navigation_fade_curve         ease_out changes visibly from the first
#                                 frame, so a switch reads as answered sooner;
#                                 smooth starts slowly
#   navigation_veil_blur          0-100, off by default; blurs under the veil,
#                                 but Dock's switch takes about twice as long
yabai -m config navigation_effect on \
    navigation_effect_type crossfade \
    navigation_effect_duration 0.25 \
    navigation_pressure_fallback veil \
    navigation_fade_curve ease_out

# =====----- Disabling Rules --------------------------------------------===== #

# Rule values are extended regular expressions. Long ones are built by
# concatenation: a backslash-newline inside quotes would splice the next
# line's indentation into the pattern.

# Exclude problematic apps and small utilities from being managed. Escape
# metacharacters in app names (the "+" of Logi Options+).
EXCLUDED_APPS="1Password|Activity Monitor|Alfred|App Store|Archive Utility|Audio MIDI Setup"
EXCLUDED_APPS="$EXCLUDED_APPS|BetterDisplay|Calculator|CleanMyMac|Company Portal|DDPM|Dictionary"
EXCLUDED_APPS="$EXCLUDED_APPS|Digital Color Meter|Finder|Google Drive|Installer|LocalSend|Logi Options\+"
EXCLUDED_APPS="$EXCLUDED_APPS|Microsoft OneDrive|Photo Booth|Preview|Python|Screen Sharing|Screenshot"
EXCLUDED_APPS="$EXCLUDED_APPS|Software Update|Steam|Stickies|Sudoku|Superwhisper|System Settings"
EXCLUDED_APPS="$EXCLUDED_APPS|Tailscale|TextEdit|The Unarchiver|Transmission|VLC"

yabai -m rule --add label="Excluded apps" app="^($EXCLUDED_APPS)$" manage=off

# Settings windows of any app, matched on the whole title so that documents
# such as AppSettings.cs stay tiled.
yabai -m rule --add label="Settings" app="^.*$" title="^(.+ )?Settings?$" manage=off

# Exclude Safari specific windows from being managed
yabai -m rule --add label="Safari" app="^Safari$" \
    title="^(General|(Tab|Password|Website|Extension)s|AutoFill|Se(arch|curity)|Privacy|Advance)$" manage=off

# Exclude "About This Mac" specific windows from being managed
yabai -m rule --add label="About This Mac" app="^System Information$" title="^About This Mac$" manage=off

# Exclude "Neural DSP Plugins"
NEURAL_DSP="Archetype Tim Henson X|Archetype Petrucci X"
yabai -m rule --add label="Neural DSP" app="^(${NEURAL_DSP})$" manage=off

# ++++++++++++++++++++++++++ Custom Developed Apps +++++++++++++++++++++++++++ #
# QT Clustering App - MAP
yabai -m rule --add label="MAP Clustering" \
    app="^java$" \
    title="^(.*Clusters?.*|.*QT Clustering.*|.*Visualizzazione.*)$" \
    manage=off

# ++++++++++++++++++++++++++++++ JetBrains IDEs ++++++++++++++++++++++++++++++ #

# Exclude JetBrains IDEs specific windows from being managed
JETBRAINS_IDES="CLion|CLion-EAP|DataGrip|DataGrip-EAP|GoLand-EAP|IntelliJ IDEA|IntelliJ IDEA EAP"
JETBRAINS_IDES="$JETBRAINS_IDES|IntelliJ IDEA-EAP|PhpStorm|PhpStorm-EAP|PyCharm|PyCharm-EAP"
JETBRAINS_IDES="$JETBRAINS_IDES|RustRover|RustRover-EAP|WebStorm|WebStorm-EAP"

JETBRAINS_DIALOGS=".*Commands?.*|.*Configurations?.*|.*Debug.*|.*Delete.*|.*devices?.*"
JETBRAINS_DIALOGS="$JETBRAINS_DIALOGS|.*Errors?.*|.*Files?.*|.*Installations?.*|.*Interpretes?.*"
JETBRAINS_DIALOGS="$JETBRAINS_DIALOGS|.*JetBrains.*|.*Licenses?.*|.*Lines?.*|.*Log.*|.*Move.*"
JETBRAINS_DIALOGS="$JETBRAINS_DIALOGS|.*Plugins?.*|.*Projects?.*|.*Rename.*|.*Resources?.*"
JETBRAINS_DIALOGS="$JETBRAINS_DIALOGS|.*Tip of the Day.*|.*Updates?.*|.*Welcome.*"

yabai -m rule --add label="JetBrains" \
    app="^($JETBRAINS_IDES)$" \
    title="^($JETBRAINS_DIALOGS)$" \
    manage=off

# ++++++++++++++++++++++++++++++ Android Studio ++++++++++++++++++++++++++++++ #
ANDROID_STUDIO_DIALOGS=".*About.*|.*Add?.*|.*Android.*|.*Commits?.*|.*Configurations?.*"
ANDROID_STUDIO_DIALOGS="$ANDROID_STUDIO_DIALOGS|.*Convert.*|.*Debug.*|.*Delete.*|.*Device.*"
ANDROID_STUDIO_DIALOGS="$ANDROID_STUDIO_DIALOGS|.*devices?.*|.*Directory.*|.*Errors?.*|.*Files?.*"
ANDROID_STUDIO_DIALOGS="$ANDROID_STUDIO_DIALOGS|.*Git.*|.*Gradle.*|.*Icons?.*|.*Injections?.*"
ANDROID_STUDIO_DIALOGS="$ANDROID_STUDIO_DIALOGS|.*Inspections?.*|.*Installations?.*|.*JetBrains.*"
ANDROID_STUDIO_DIALOGS="$ANDROID_STUDIO_DIALOGS|.*Languages?.*|.*Lines?.*|.*Log.*|.*Move.*"
ANDROID_STUDIO_DIALOGS="$ANDROID_STUDIO_DIALOGS|.*Plugins?.*|.*Process?.*|.*Projects?.*|.*Provide?.*"
ANDROID_STUDIO_DIALOGS="$ANDROID_STUDIO_DIALOGS|.*Rename.*|.*Resources?.*|.*SDK.*|.*Select?.*"
ANDROID_STUDIO_DIALOGS="$ANDROID_STUDIO_DIALOGS|.*Studio.*|.*Tip of the Day.*|.*Updates?.*|.*Welcome.*"

yabai -m rule --add \
    label="Android Studio" \
    app="^.*Android Studio.*$" \
    title="^($ANDROID_STUDIO_DIALOGS)$" \
    manage=off

# ++++++++++++++++++++++++++++++++ DataSpell +++++++++++++++++++++++++++++++++ #
DATASPELL_DIALOGS=".*Commands?.*|.*Configurations?.*|.*Console.*|.*Data.*|.*DataSpell.*"
DATASPELL_DIALOGS="$DATASPELL_DIALOGS|.*Debug.*|.*Delete.*|.*devices?.*|.*Errors?.*|.*Files?.*"
DATASPELL_DIALOGS="$DATASPELL_DIALOGS|.*Installations?.*|.*JetBrains.*|.*Jupyter.*|.*Licenses?.*"
DATASPELL_DIALOGS="$DATASPELL_DIALOGS|.*Lines?.*|.*Log.*|.*Manage.*|.*Move.*|.*Notebook.*"
DATASPELL_DIALOGS="$DATASPELL_DIALOGS|.*Plugins?.*|.*Projects?.*|.*Python.*|.*Rename.*|.*Packages?.*"
DATASPELL_DIALOGS="$DATASPELL_DIALOGS|.*Resources?.*|.*Settings.*|.*Tip of the Day.*|.*Updates?.*"
DATASPELL_DIALOGS="$DATASPELL_DIALOGS|.*Welcome.*"

yabai -m rule --add \
    label="DataSpell" \
    app="^.*DataSpell.*$" \
    title="^($DATASPELL_DIALOGS)$" \
    manage=off

# The dialog patterns above also match main editor windows whose project or
# file name contains one of their words (LogParser.cpp, MyAndroidApp). Main
# windows are titled "project – file" with an en dash, which no dialog uses;
# later rules win, so these are tiled again.
yabai -m rule --add \
    label="JetBrains main windows" \
    app="^($JETBRAINS_IDES|.*Android Studio.*|.*DataSpell.*)$" \
    title="^.+ – .+$" \
    manage=on

# +++++++++++++++++++++++++++++++++ Eclipse ++++++++++++++++++++++++++++++++++ #
ECLIPSE_DIALOGS=".*Configuration.*|.*Errors?.*|.*Install.*|.*Import.*|.*Marketplace.*"
ECLIPSE_DIALOGS="$ECLIPSE_DIALOGS|.*Preferences.*|.*Problems?.*|.*Projects?.*|.*Resources?.*"

yabai -m rule --add \
    label="Eclipse" \
    app="^.*Eclipse.*$" \
    title="^($ECLIPSE_DIALOGS)$" \
    manage=off

# +++++++++++++++++++++++++++++ Other Exclusions +++++++++++++++++++++++++++++ #
# Exclude "VNC Viewer" specific windows from being managed.
yabai -m rule --add label="VNC Viewer" \
    app="^VNC Viewer$" \
    title="^(.*VNC.*|.*Viewer.*|.*RealVNC.*)$" \
    manage=off

# Exclude GIMP transient/context dialogs (About / Welcome, etc.).
GIMP_APP="GIMP|GIMP-2\\..*|GNU Image Manipulation Program"
GIMP_DIALOGS=".*About.*|.*Change.*|.*Close.*|.*Create.*|.*Embedded.*|.*Export.*|.*Merge.*"
GIMP_DIALOGS="$GIMP_DIALOGS|.*Quit.*|.*Save.*|.*Spaces?.*|.*Welcome.*|.*Working.*"
yabai -m rule --add label="GIMP Popups" \
    app="^(${GIMP_APP})$" \
    title="^($GIMP_DIALOGS)$" \
    manage=off

# Exclude Godot Editor transient/context dialogs (About / Welcome, etc.).
GODOT_APP="Godot"
GODOT_DIALOGS=".*Create.*|.*Confirm.*|.*DEBUG.*|.*New.*|.*Node.*|.*Please.*|.*Preview.*"
GODOT_DIALOGS="$GODOT_DIALOGS|.*Project.*|.*Quit.*|.*Save.*|.*Scene.*|.*Settings.*"
yabai -m rule --add label="Godot Popups" \
    app="^(${GODOT_APP})$" \
    title="^($GODOT_DIALOGS)$" \
    manage=off

# Exclude Rancher Desktop/OrbStack preference windows from tiling.
yabai -m rule --add label="Rancher Desktop Preferences" \
    app="^Rancher Desktop$" \
    title="^Rancher Desktop - Preferences$" \
    manage=off

yabai -m rule --add label="OrbStack Preferences" \
    app="^OrbStack$" \
    title="^(General.*|System.*|Network.*|Storage.*|Machine.*|Docker.*|Kubernetes.*)$" \
    manage=off

# Exclude a subset of Obsidian windows (titles: save, Save, Vault).
yabai -m rule --add \
    label="Obsidian" \
    app="^Obsidian$" \
    title="^(save|Save|Vault)$" \
    manage=off

# Rules only reach windows created after them; apply them to the windows that
# were already open when yabai (re)started.
yabai -m rule --apply

echo "yabai configuration loaded..."
