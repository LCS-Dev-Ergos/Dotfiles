{
  "general": {
    "apps": {
      "terminal": ["/usr/bin/kitty"],
      "explorer": ["/usr/bin/dolphin"],
      "audio": ["/usr/bin/pavucontrol"],
      "playback": ["/usr/bin/mpv"]
    },
    "idle": {
      "lockBeforeSleep": true,
      "inhibitWhenAudio": true,
      "inhibitWhenCharging": false,
      "timeouts": [
        {"timeout": 300, "idleAction": "lock", "respectInhibitors": true},
        {"timeout": 900, "idleAction": "dpms off", "returnAction": "dpms on"}
      ]
    },
    "battery": {"criticalLevel": -1}
  },
  "session": {
    "commands": {
      "logout": ["/usr/bin/uwsm", "stop"],
      "hibernate": ["/usr/bin/notify-send", "Sleep disabled", "NVIDIA resume validation is pending."]
    }
  },
  "launcher": {"enableDangerousActions": false},
  "lock": {"enableFprint": false, "enableHowdy": false, "triggerHowdyOnWake": false},
  "paths": {"wallpaperDir": "~/Pictures/Wallpapers"}
}
