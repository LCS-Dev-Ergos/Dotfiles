--- a/src/event.c
+++ b/src/event.c
@@ -52,3 +52,14 @@
 static void event_system_woke(void* context) {
-  bar_manager_handle_system_woke(&g_bar_manager);
+  if (context && !g_bar_manager.sleeps && g_bar_manager.bar_count > 0) {
+    // Real display changes retain their existing reset handlers.
+    bar_manager_handle_display_change(&g_bar_manager);
+    bar_manager_handle_space_change(&g_bar_manager, false);
+    g_bar_manager.needs_ordering = true;
+    bar_manager_refresh(&g_bar_manager, true);
+    animator_renew_display_link(&g_bar_manager.animator);
+    bar_manager_custom_events_trigger(&g_bar_manager,
+                                     COMMAND_SUBSCRIBE_SYSTEM_WOKE, NULL);
+  } else {
+    bar_manager_handle_system_woke(&g_bar_manager);
+  }
 }
--- a/src/workspace.m
