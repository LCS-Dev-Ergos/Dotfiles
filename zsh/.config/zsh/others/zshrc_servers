# Quick jump to a file's parent directory using fzf.
cdf() {
    command -v fzf >/dev/null 2>&1 \
        || { echo "${C_YELLOW}fzf is required for cdf${C_RESET}" >&2; return 1 }
    local target
    target=$(fzf --select-1 --exit-0) || return 1
    cd -- "$(dirname -- "$target")"
}

# Robust archive extraction (fallback when OMZP::extract is unavailable).
# The OMZ plugin — if loaded via Zinit — will shadow this with its own version.
if ! typeset -f extract >/dev/null 2>&1; then
    extract() {
        (( $# == 0 )) && { echo "Usage: extract <file> [file2 ...]" >&2; return 1 }
        local f
        for f in "$@"; do
            [[ -f "$f" ]] || { echo "extract: not a file: $f" >&2; continue }
            case "${f:l}" in
                *.tar.bz2)  tar xjf "$f"            ;;
                *.tar.gz)   tar xzf "$f"             ;;
                *.tar.xz)   tar xJf "$f"             ;;
                *.tar.zst)  tar --zstd -xf "$f"      ;;
                *.tar)      tar xf  "$f"             ;;
                *.bz2)      bunzip2 "$f"             ;;
                *.gz)       gunzip  "$f"             ;;
                *.zip)      unzip   "$f"             ;;
                *.7z)       7z x    "$f"             ;;
                *.rar)      unrar x "$f"             ;;
                *.xz)       unxz    "$f"             ;;
                *.zst)      zstd -d "$f"             ;;
                *)          echo "extract: unknown format: $f" >&2 ;;
            esac
        done
    }
    alias x='extract'
fi

