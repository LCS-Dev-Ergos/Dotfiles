# =============================== PATH BUILDER =============================== #
#
# Rebuilds PATH in a deterministic, priority-ordered sequence:
#   1. Dynamic version-manager shims (highest priority).
#   2. SDKMAN / static language bins.
#   3. FNM current session.
#   4. System directories.
#   5. Linuxbrew.
#   6. Language runtime bins (Cargo, Go, etc.).
#   7. User-local bins.
#   8. Any extra paths already in PATH (IDE injections, etc.) appended last.
#
# Non-existent directories are silently skipped.
# Duplicates are removed via an associative-array seen-set.

_srv_build_path() {
    local original_path="$PATH"

    local -a template=(
        # Dynamic shims — must be first so version managers intercept commands.
        "$HOME/.rbenv/shims"
        "$HOME/.pyenv/shims"

        # Version manager bins.
        "${PYENV_ROOT:-$HOME/.pyenv}/bin"
        "${SDKMAN_DIR:-$HOME/.sdkman}/candidates/java/current/bin"
        "${SDKMAN_DIR:-$HOME/.sdkman}/candidates/maven/current/bin"
        "${SDKMAN_DIR:-$HOME/.sdkman}/candidates/gradle/current/bin"
        "${SDKMAN_DIR:-$HOME/.sdkman}/candidates/kotlin/current/bin"

        # FNM current multishell session.
        "${FNM_MULTISHELL_PATH:-}/bin"

        # Standard system directories.
        "/usr/local/bin"
        "/usr/bin"
        "/bin"
        "/usr/local/sbin"
        "/usr/sbin"
        "/sbin"

        # Linuxbrew.
        "/home/linuxbrew/.linuxbrew/bin"
        "/home/linuxbrew/.linuxbrew/sbin"

        # Language runtimes.
        "$HOME/.cargo/bin"
        "$HOME/.ghcup/bin"
        "$HOME/.cabal/bin"
        "$HOME/.elan/bin"
        "${GOPATH:-$HOME/go}/bin"
        "$HOME/.rbenv/bin"

        # Node (system npm global bin, fallback when fnm is not initialised).
        "$HOME/.npm/bin"
        "$HOME/.local/share/npm/bin"

        # Conda / Miniforge condabin (lightweight; avoids full conda activate).
        "/opt/miniconda3/condabin"
        "$HOME/.miniforge3/condabin"

        # User-local binaries.
        "$HOME/.local/bin"
        "$HOME/.lcs-bin"
    )

    local -a new_path=()
    local -A seen

    _add_to_path() {
        local d="$1"
        [[ -d "$d" && -z "${seen[$d]}" ]] || return
        new_path+=("$d")
        seen[$d]=1
    }

    # 1. Prioritised template paths.
    local d
    for d in "${template[@]}"; do _add_to_path "$d"; done

    # 2. Preserve any paths already in PATH (e.g., injected by the SSH server,
    #    IDE remote extensions, or container entrypoints) that are not yet seen.
    local -a orig_path_array=("${(@s/:/)original_path}")
    for d in "${orig_path_array[@]}"; do _add_to_path "$d"; done

    unset -f _add_to_path

    local IFS=':'
    export PATH="${new_path[*]}"
    typeset -gU PATH
}

_srv_build_path
unset -f _srv_build_path

